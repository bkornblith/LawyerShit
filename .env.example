# Copy to .env.local for local development. Set the same values in Vercel
# (Project Settings > Environment Variables). Never commit real values.

# Long random string used to sign login sessions. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Passwords for the two partners. Usernames are "julia" and "brendan".
JULIA_PASSWORD=
BRENDAN_PASSWORD=

# Form filler. Claude API key (console.anthropic.com) for filling forms
# automatically; without it, forms can still be filled by hand.
ANTHROPIC_API_KEY=

# Form library storage. Added automatically when a private Vercel Blob store is
# connected to the project. Leave empty locally to keep forms in .data/forms/.
BLOB_READ_WRITE_TOKEN=
